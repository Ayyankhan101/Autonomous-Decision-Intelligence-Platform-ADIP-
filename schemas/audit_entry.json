{
  "$defs": {
    "AuditLayaMetadata": {
      "additionalProperties": false,
      "properties": {
        "laya_answer_confidence_priority": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Answer Confidence Priority"
        },
        "laya_checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Checkpoint"
        },
        "laya_fallback_used": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Fallback Used"
        },
        "laya_final_decision_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "laya_guardrail_applied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Guardrail Applied"
        },
        "laya_guardrail_modified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Guardrail Modified"
        },
        "laya_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Latency Ms"
        },
        "laya_questions_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Questions Hash"
        },
        "laya_questions_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Questions Version"
        },
        "laya_router_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya Router Model"
        },
        "laya_state_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Laya State Hash"
        },
        "laya_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayaStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "laya_suggested_priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AuditLayaMetadata",
      "type": "object"
    },
    "DecisionSource": {
      "enum": [
        "laya_proposed",
        "policy_finalized",
        "fallback_rule",
        "human_required"
      ],
      "title": "DecisionSource",
      "type": "string"
    },
    "LayaStatus": {
      "enum": [
        "ok",
        "error",
        "timeout",
        "invalid_response",
        "unavailable"
      ],
      "title": "LayaStatus",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "actor": {
      "description": "operator_id or 'system'",
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "after_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After State"
    },
    "before_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Before State"
    },
    "decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Id"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "entry_hash": {
      "minLength": 1,
      "title": "Entry Hash",
      "type": "string"
    },
    "entry_id": {
      "title": "Entry Id",
      "type": "string"
    },
    "incident_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incident Id"
    },
    "laya": {
      "$ref": "#/$defs/AuditLayaMetadata"
    },
    "model_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Model Versions",
      "type": "object"
    },
    "policy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "previous_hash": {
      "minLength": 1,
      "title": "Previous Hash",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 2000,
      "title": "Reason",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "entry_id",
    "timestamp",
    "actor",
    "action",
    "previous_hash",
    "entry_hash"
  ],
  "title": "AuditEntry",
  "type": "object"
}
