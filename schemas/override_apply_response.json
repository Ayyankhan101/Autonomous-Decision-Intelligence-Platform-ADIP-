{
  "$defs": {
    "DecisionState": {
      "enum": [
        "AUTO_APPROVED",
        "HOLD_FOR_HUMAN",
        "REJECTED_INPUT",
        "CONTENTION_ESCALATION",
        "OVERRIDE_ACTIVE",
        "MODEL_DEGRADED"
      ],
      "title": "DecisionState",
      "type": "string"
    },
    "ImpactTier": {
      "enum": [
        "LOW",
        "HIGH",
        "BREAK_GLASS"
      ],
      "title": "ImpactTier",
      "type": "string"
    },
    "OverrideContextCode": {
      "enum": [
        "SCENE_REPORT",
        "COMMAND_ORDER",
        "ROAD_CONDITION",
        "SENSOR_FAILURE",
        "EXTERNAL_AGENCY",
        "OTHER"
      ],
      "title": "OverrideContextCode",
      "type": "string"
    },
    "OverrideReasonCode": {
      "enum": [
        "POLICY_CLAUSE",
        "POLICY_GAP",
        "EXTERNAL_CONTEXT"
      ],
      "title": "OverrideReasonCode",
      "type": "string"
    },
    "OverrideRecord": {
      "additionalProperties": false,
      "properties": {
        "break_glass": {
          "default": false,
          "title": "Break Glass",
          "type": "boolean"
        },
        "cited_clause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cited Clause"
        },
        "context_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverrideContextCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "impact_tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "override_type": {
          "$ref": "#/$defs/OverrideType"
        },
        "previous_priority": {
          "$ref": "#/$defs/Priority"
        },
        "previous_state": {
          "$ref": "#/$defs/DecisionState"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverrideReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "override_type",
        "reason",
        "timestamp",
        "previous_state",
        "previous_priority"
      ],
      "title": "OverrideRecord",
      "type": "object"
    },
    "OverrideType": {
      "enum": [
        "CHANGE_PRIORITY",
        "ASSIGN_RESOURCES",
        "DISMISS_INCIDENT",
        "ESCALATE_TO_HUMAN",
        "MARK_DATA_UNTRUSTED",
        "OVERRIDE_AUTOMATION_HOLD"
      ],
      "title": "OverrideType",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "POST /api/overrides result: the new override decision's id plus its audit\nrecord. The override is an immutable NEW decision (previous id keeps its\noriginal record); clients need the new id to track the override chain.",
  "properties": {
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "override": {
      "$ref": "#/$defs/OverrideRecord"
    }
  },
  "required": [
    "decision_id",
    "override"
  ],
  "title": "OverrideApplyResponse",
  "type": "object"
}
