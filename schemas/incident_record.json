{
  "$defs": {
    "DamageSeverity": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ],
      "title": "DamageSeverity",
      "type": "string"
    },
    "IncidentLifecycle": {
      "enum": [
        "detected",
        "validated",
        "prioritized",
        "resource_assigned",
        "active",
        "resolved"
      ],
      "title": "IncidentLifecycle",
      "type": "string"
    },
    "IncidentType": {
      "enum": [
        "accident",
        "fire",
        "flood",
        "traffic_spike"
      ],
      "title": "IncidentType",
      "type": "string"
    },
    "SceneType": {
      "enum": [
        "accident",
        "fire",
        "flood",
        "traffic",
        "other",
        "unknown"
      ],
      "title": "SceneType",
      "type": "string"
    },
    "SeverityHint": {
      "enum": [
        "minor",
        "moderate",
        "severe"
      ],
      "title": "SeverityHint",
      "type": "string"
    },
    "ValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "pattern": "^(hard|soft)$",
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "title": "ValidationFinding",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "valid",
        "soft_flagged",
        "hard_rejected"
      ],
      "title": "ValidationStatus",
      "type": "string"
    },
    "VisionAttachment": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "$ref": "#/$defs/VisionFacts"
        },
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "latest_decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Decision Id"
        },
        "soft_findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Soft Findings",
          "type": "array"
        }
      },
      "required": [
        "image_id",
        "facts"
      ],
      "title": "VisionAttachment",
      "type": "object"
    },
    "VisionFacts": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Confidence",
          "type": "object"
        },
        "damage_severity": {
          "$ref": "#/$defs/DamageSeverity",
          "default": "unknown"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "injuries_visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Injuries Visible"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "mode": {
          "$ref": "#/$defs/VisionMode"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Objects",
          "type": "array"
        },
        "scene": {
          "$ref": "#/$defs/SceneType",
          "default": "unknown"
        },
        "status": {
          "$ref": "#/$defs/VisionStatus",
          "default": "ok"
        }
      },
      "required": [
        "image_sha256",
        "model_id",
        "model_version",
        "mode",
        "latency_ms"
      ],
      "title": "VisionFacts",
      "type": "object"
    },
    "VisionMode": {
      "enum": [
        "mock",
        "cache",
        "live"
      ],
      "title": "VisionMode",
      "type": "string"
    },
    "VisionStatus": {
      "enum": [
        "ok",
        "unavailable",
        "invalid_response"
      ],
      "title": "VisionStatus",
      "type": "string"
    },
    "Zone": {
      "enum": [
        "north",
        "south",
        "east",
        "west",
        "central"
      ],
      "title": "Zone",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assigned_resource_ids": {
      "items": {
        "type": "string"
      },
      "title": "Assigned Resource Ids",
      "type": "array"
    },
    "first_seen_simulated": {
      "format": "date-time",
      "title": "First Seen Simulated",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "incident_type": {
      "$ref": "#/$defs/IncidentType"
    },
    "lat": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Incident latitude (workstream B2): real coords from live feeds, zone-centroid jitter in mock mode.",
      "title": "Lat"
    },
    "latest_simulated": {
      "format": "date-time",
      "title": "Latest Simulated",
      "type": "string"
    },
    "lifecycle": {
      "$ref": "#/$defs/IncidentLifecycle",
      "default": "detected"
    },
    "lon": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Incident longitude (workstream B2): real coords from live feeds, zone-centroid jitter in mock mode.",
      "title": "Lon"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Free-text notes carried from the originating report (display-only; never enters the Laya state, Invariant 16).",
      "title": "Notes"
    },
    "report_count": {
      "default": 0,
      "minimum": 0,
      "title": "Report Count",
      "type": "integer"
    },
    "severity_hint": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeverityHint"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Severity hint carried from the first registered report (used by vision soft-flag comparison; display/audit only)."
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "validation_status": {
      "$ref": "#/$defs/ValidationStatus",
      "default": "valid"
    },
    "vision": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisionAttachment"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Vision evidence attached post-decision (display + soft flags only; never writes severity)."
    },
    "zone": {
      "$ref": "#/$defs/Zone"
    }
  },
  "required": [
    "incident_id",
    "incident_type",
    "zone",
    "first_seen_simulated",
    "latest_simulated"
  ],
  "title": "IncidentRecord",
  "type": "object"
}
