{
  "$defs": {
    "ResourceStatus": {
      "enum": [
        "available",
        "assigned",
        "busy",
        "offline"
      ],
      "title": "ResourceStatus",
      "type": "string"
    },
    "ResourceType": {
      "enum": [
        "ambulance",
        "fire_truck",
        "police_unit",
        "flood_response_unit",
        "traffic_management_unit"
      ],
      "title": "ResourceType",
      "type": "string"
    },
    "Zone": {
      "enum": [
        "north",
        "south",
        "east",
        "west",
        "central"
      ],
      "title": "Zone",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assigned_incident_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned Incident Id"
    },
    "eco_score": {
      "default": 0.0,
      "description": "Eco-optimisation fitness (1 = electric/zero-emission response vehicle, 0 = highest-emission). Used only when the policy position is ECO.",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Eco Score",
      "type": "number"
    },
    "lat": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Live-mode station latitude (workstream B2); None in mock mode.",
      "title": "Lat"
    },
    "lon": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Live-mode station longitude (workstream B2); None in mock mode.",
      "title": "Lon"
    },
    "resource_id": {
      "title": "Resource Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ResourceStatus",
      "default": "available"
    },
    "type": {
      "$ref": "#/$defs/ResourceType"
    },
    "zone": {
      "$ref": "#/$defs/Zone"
    }
  },
  "required": [
    "resource_id",
    "type",
    "zone"
  ],
  "title": "Resource",
  "type": "object"
}
